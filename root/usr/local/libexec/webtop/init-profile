#!/usr/bin/with-contenv bash
# Prepare system directories and delegate missing user-profile initialization to desktop user abc.
set -eu

TARGET_HOME=/config
mkdir -p "$TARGET_HOME" /tmp/.X11-unix /etc/omarchy
chmod 1777 /tmp/.X11-unix

# LinuxServer remaps abc to PUID but image-seeded descendants can retain its
# build-time UID. Repair those before unprivileged profile initialization.
/usr/local/libexec/webtop/prepare-home "$TARGET_HOME" \
  "$(id -u abc)" "$(id -g abc)" "$(cat /usr/share/webtop/desktop-base-uid)"

# Show Omarchy branding in the Selkies dashboard if available.
if [[ -f /usr/share/omarchy/icon.png && -d /usr/share/selkies/www ]]; then
  cp -f /usr/share/omarchy/icon.png /usr/share/selkies/www/icon.png
fi

# Initialize missing profile defaults strictly as user abc (safe retry happens in startwm_wayland.sh if interrupted).
if ! s6-setuidgid abc env HOME="$TARGET_HOME" /usr/local/bin/omarchy-init-home; then
  echo "[omarchy-init] Profile initialization incomplete; desktop startup will retry." >&2
fi
