#!/usr/bin/env bash
# Expose tracked customizations at the native Omarchy consumer paths.
set -euo pipefail
shopt -s nullglob nocaseglob

extensions=${1:-$HOME/webtop-extensions}
if (( $# == 0 )) && mountpoint -q /webtop-extensions; then
  extensions=/webtop-extensions
fi

menu="$extensions/omarchy-menu.jsonc"
menu_target="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
menu_default=/defaults/omarchy-profile/.config/omarchy/extensions/omarchy-menu.jsonc
if [[ -f "$menu" && ! -L "$menu" ]]; then
  mkdir -p -- "${menu_target%/*}"
  previous=$(readlink -- "$menu_target") || previous=
  if [[ $previous == "$HOME/webtop-extensions/omarchy-menu.jsonc" ||
        $previous == "/webtop-extensions/omarchy-menu.jsonc" ]] ||
     { [[ ! -L "$menu_target" ]] && cmp -s -- "$menu_default" "$menu_target"; }; then
    ln -sfnT -- "$menu" "$menu_target"
  elif [[ ! -e "$menu_target" && ! -L "$menu_target" ]]; then
    ln -sT -- "$menu" "$menu_target"
  fi
fi

for theme_dir in "$extensions"/backgrounds/*/; do
  theme_dir=${theme_dir%/}
  [[ ! -L "$theme_dir" ]] || continue
  target="$HOME/.config/omarchy/backgrounds/${theme_dir##*/}"
  for media in "$theme_dir"/*.{jpg,jpeg,png,gif,bmp,webp,mp4,m4v,mov,webm,mkv,avi}; do
    [[ -f "$media" && ! -L "$media" ]] || continue
    mkdir -p -- "$target"
    link="$target/${media##*/}"
    relative="backgrounds/${theme_dir##*/}/${media##*/}"
    current=$(readlink -- "$link") || current=
    if [[ $current == "$HOME/webtop-extensions/$relative" || $current == "/webtop-extensions/$relative" ]]; then
      ln -sfnT -- "$media" "$link"
    elif ! ln -sT -- "$media" "$link" 2>/dev/null &&
       [[ ! -e "$link" && ! -L "$link" ]]; then
      printf 'Could not expose wallpaper: %s\n' "$link" >&2
      exit 1
    fi
  done
done
