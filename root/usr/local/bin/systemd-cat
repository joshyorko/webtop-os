#!/bin/bash
# Container shim for systemd-cat: delegates to systemd journal when running
# under systemd, otherwise redirects command output to an Omarchy state log.

if [[ -S /run/systemd/journal/stdout && -x /usr/bin/systemd-cat ]]; then
  exec /usr/bin/systemd-cat "$@"
fi

tag="omarchy"
while (( $# > 0 )); do
  case "$1" in
    -t|--identifier)
      tag="${2:-omarchy}"
      shift 2
      ;;
    --identifier=*)
      tag="${1#--identifier=}"
      shift
      ;;
    -p|--priority|--stderr-priority)
      shift 2
      ;;
    --priority=*|--stderr-priority=*|--level-prefix=*)
      shift
      ;;
    --)
      shift
      break
      ;;
    -h|--help|--version)
      if [[ -x /usr/bin/systemd-cat ]]; then
        exec /usr/bin/systemd-cat "$@"
      fi
      exit 0
      ;;
    -*)
      shift
      ;;
    *)
      break
      ;;
  esac
done

log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/logs"
mkdir -p "$log_dir" 2>/dev/null || log_dir="/tmp"
safe_tag="${tag//[^A-Za-z0-9._-]/_}"
log_file="$log_dir/${safe_tag:-omarchy}.log"

if (( $# > 0 )); then
  exec "$@" >>"$log_file" 2>&1
fi

exec cat >>"$log_file"
