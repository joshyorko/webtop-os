ARG WEBTOP_BASE=webtop-os:devcontainer
FROM ${WEBTOP_BASE}

COPY webtop-packages.txt /tmp/webtop-packages.txt
RUN set -eu; \
    set -- $(awk 'NF && $1 !~ /^#/ {print $1}' /tmp/webtop-packages.txt); \
    if [ "$#" -gt 0 ]; then \
      pacman -Syu --noconfirm --needed "$@"; \
      rm -rf /var/cache/pacman/pkg/* /var/lib/pacman/sync/*; \
    fi; \
    rm /tmp/webtop-packages.txt
