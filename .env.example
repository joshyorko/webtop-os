# Cloud-Native OCI Compose Settings (keep real secrets in private .env only)
PUID=1000
PGID=1000
WEBTOP_USER=kdlocpanda
WEBTOP_GIT_NAME=joshyorko
WEBTOP_GIT_EMAIL=joshyorko@users.noreply.github.com
TZ=America/New_York
TITLE=Omarchy Quattro RS
PORT_HTTP=3000
PORT_HTTPS=3001
OMARCHY_MODE=1920x1080@60
OMARCHY_SCALE=1
OMARCHY_GDK_SCALE=1
UPDATE_ACTIONS_TOOLS=false
SELKIES_MICROPHONE_ENABLED=false

# Optional HTTP Basic Auth & Sudo Credentials (set in .env, never commit real values)
CUSTOM_USER=
PASSWORD=
SUDO_PASSWORD=

# Optional Coolify / PaaS Deployment Variables
SERVICE_FQDN_WEBTOP=
SERVICE_USER_WEBTOP=
SERVICE_PASSWORD_WEBTOP=

# Opt-in compose.host-auth.yaml settings. Keep the directory outside the checkout.
# WEBTOP_HOST_AUTH_DIR=/run/user/1000/webtop-auth
# WEBTOP_DOCKER_REGISTRY=ghcr.io
